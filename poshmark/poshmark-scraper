def _utc_now_iso() -> str:
    return datetime.now(timezone.utc).isoformat()


def _append_jsonl(path: Path, row: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as f:
        f.write(json.dumps(row, indent=2, ensure_ascii=False) + "\n")


def _replace_nulls(value: Any) -> Any:
    if value is None:
        return ""
    if isinstance(value, dict):
        return {k: _replace_nulls(v) for k, v in value.items()}
    if isinstance(value, list):
        return [_replace_nulls(item) for item in value]
    return value


def _first_non_empty(*values: Any) -> Any:
    for value in values:
        if value not in (None, "", [], {}):
            return value
    return None


def _walk(node: Any):
    if isinstance(node, dict):
        yield node
        for value in node.values():
            yield from _walk(value)
    elif isinstance(node, list):
        for value in node:
            yield from _walk(value)


def _extract_listing_id(url: str) -> Optional[str]:
    # Canonical Poshmark listing URLs usually end with an alphanumeric token,
    # e.g. /listing/<slug>-6a61addfa6bb76132aadbaa9.
    match = re.search(r"/listing/[^/]+-([A-Za-z0-9]{8,})(?:[/?#].*)?$", url)
    if match:
        return match.group(1)

    # Legacy fallback for purely numeric URL ids.
    numeric_match = re.search(r"/listing/[^/]+-(\d+)(?:[/?#].*)?$", url)
    return numeric_match.group(1) if numeric_match else None


def _score_item_candidate(obj: dict, listing_id: Optional[str]) -> int:
    score = 0
    if listing_id and str(obj.get("id")) == listing_id:
        score += 6

    for key in (
        "title",
        "description",
        "price",
        "brand",
        "category",
        "size",
        "condition",
        "seller",
        "closet",
        "cover_shot",
        "pictures",
    ):
        if obj.get(key) not in (None, "", [], {}):
            score += 1
    return score


def _find_best_item_blob(payload: Any, listing_id: Optional[str]) -> dict:
    best_obj: dict = {}
    best_score = 0

    for obj in _walk(payload):
        if not isinstance(obj, dict):
            continue
        score = _score_item_candidate(obj, listing_id)
        if score > best_score:
            best_obj = obj
            best_score = score

    return best_obj


def _find_first_value(payload: Any, keys: tuple[str, ...]) -> Any:
    for obj in _walk(payload):
        if not isinstance(obj, dict):
            continue
        for key in keys:
            value = obj.get(key)
            if value not in (None, "", [], {}):
                return value
    return None


def _extract_internal_seller_id(state: dict) -> Optional[str]:
    """Prefer known internal seller ID locations from Poshmark bootstrap state."""
    if not isinstance(state, dict):
        return None

    candidates = [
        # Listing page bootstrap.
        state.get("$_listing_details", {}).get("listerData", {}).get("id") if isinstance(state.get("$_listing_details"), dict) else None,
        state.get("$_listing_details", {}).get("listingDetails", {}).get("creator_id") if isinstance(state.get("$_listing_details"), dict) else None,
        # Closet page bootstrap.
        state.get("$_closet", {}).get("closetUserInfo", {}).get("data", {}).get("id") if isinstance(state.get("$_closet"), dict) else None,
    ]

    for value in candidates:
        if value not in (None, "", [], {}):
            return str(value)

    return None


def _normalize_price(price_value: Any, currency_value: Any, fallback_text: Optional[str]) -> tuple[Optional[str], Optional[str]]:
    amount = None
    currency = None

    if isinstance(price_value, dict):
        amount = _first_non_empty(price_value.get("amount"), price_value.get("value"), price_value.get("price"))
        currency = _first_non_empty(
            price_value.get("currency"),
            price_value.get("currency_code"),
            currency_value,
        )
    elif price_value not in (None, "", [], {}):
        amount = price_value
        currency = currency_value

    if amount is None and fallback_text:
        match = re.search(r"\$\s*([\d,]+(?:\.\d+)?)", fallback_text)
        if match:
            amount = match.group(1).replace(",", "")
            currency = currency or "USD"

    if amount is None:
        return None, currency if currency else None

    amount_text = str(amount).strip().replace(",", "")
    if not amount_text:
        return None, currency if currency else None

    currency_text = str(currency).strip().upper() if currency not in (None, "", [], {}) else None
    return amount_text, currency_text


def _lowest_category(raw: Any) -> Optional[str]:
    if isinstance(raw, dict):
        # Prefer common deepest keys when category is structured.
        raw = _first_non_empty(
            raw.get("leaf"),
            raw.get("sub_subcategory"),
            raw.get("subcategory"),
            raw.get("name"),
            raw.get("title"),
            raw.get("category"),
        )

    if not isinstance(raw, str):
        return None

    text = raw.strip()
    if not text:
        return None

    # Handle hierarchy separators used by marketplace/category strings.
    parts = re.split(r"\s*[<>|/»]+\s*", text)
    parts = [p.strip() for p in parts if p and p.strip()]
    leaf = parts[-1] if parts else text

    # Common cleanup for breadcrumb-like labels.
    leaf = leaf.replace("_", " ").strip()
    leaf = re.sub(r"^(women|women's|mens|men's|kids|home)\s+", "", leaf, flags=re.IGNORECASE)
    leaf = re.sub(r"\s+", " ", leaf).strip()
    return leaf or None


def _normalize_created_at(raw_value: Any) -> Optional[str]:
    if raw_value in (None, "", [], {}):
        return None
    if isinstance(raw_value, (int, float)):
        ts = float(raw_value)
        if ts > 1_000_000_000_000:
            ts /= 1000.0
        return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(ts))
    value = str(raw_value).strip()
    if not value:
        return None
    if re.fullmatch(r"\d+", value):
        return _normalize_created_at(int(value))
    return value


def _relative_age_to_iso(raw: Any) -> Optional[str]:
    if not isinstance(raw, str):
        return None
    text = raw.strip().lower()
    if not text:
        return None

    if text in {"just now", "now"}:
        return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())

    match = re.search(
        r"(\d+|an?|one)\s+(sec|secs|second|seconds|min|mins|minute|minutes|h|hr|hrs|hour|hours|d|day|days|w|wk|wks|week|weeks|mo|month|months|yr|year|years)\s+ago",
        text,
    )
    if not match:
        return None

    qty = 1 if match.group(1) in {"a", "an", "one"} else int(match.group(1))
    unit = match.group(2)
    unit_seconds = {
        "sec": 1,
        "secs": 1,
        "second": 1,
        "seconds": 1,
        "min": 60,
        "mins": 60,
        "minute": 60,
        "minutes": 60,
        "h": 3600,
        "hr": 3600,
        "hrs": 3600,
        "hour": 3600,
        "hours": 3600,
        "d": 86400,
        "day": 86400,
        "days": 86400,
        "w": 604800,
        "wk": 604800,
        "wks": 604800,
        "week": 604800,
        "weeks": 604800,
        "mo": 2629800,
        "month": 2629800,
        "months": 2629800,
        "yr": 31557600,
        "year": 31557600,
        "years": 31557600,
    }
    seconds = unit_seconds.get(unit)
    if not seconds:
        return None

    ts = datetime.now(timezone.utc).timestamp() - qty * seconds
    return datetime.fromtimestamp(ts, tz=timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _created_at_from_image_url(url: Any) -> Optional[str]:
    if not isinstance(url, str):
        return None
    # Poshmark image URLs usually include /posts/YYYY/MM/DD/<listing_id>/...
    match = re.search(r"/posts/(\d{4})/(\d{2})/(\d{2})/", url)
    if not match:
        return None
    year, month, day = match.groups()
    return f"{year}-{month}-{day}T00:00:00Z"


def _normalize_item_condition(raw: Any) -> Optional[str]:
    if not isinstance(raw, str):
        return None
    value = raw.strip()
    if not value:
        return None

    if value.startswith("https://schema.org/"):
        value = value.rsplit("/", 1)[-1]

    mapping = {
        "newcondition": "New",
        "usedcondition": "Used",
        "damagedcondition": "Damaged",
        "refurbishedcondition": "Refurbished",
        "nwt": "New",
        "new": "New",
        "nwot": "New",
        "used": "Used",
        "ug": "Used",
        "uf": "Used",
        "uln": "Used",
        "good": "Used",
        "vg": "Used",
        "excellent": "Used",
    }
    canonical = mapping.get(value.lower())
    if canonical:
        return canonical

    # Internal codes are sometimes 2-3 letters (e.g. uf/uln/ug).
    if len(value) <= 3:
        lower = value.lower()
        if lower.startswith("u"):
            return "Used"
        if lower.startswith("n"):
            return "New"

    return re.sub(r"([a-z])([A-Z])", r"\1 \2", value)


def _normalize_location(raw: Any) -> Optional[str]:
    if not isinstance(raw, str):
        return None
    value = raw.strip()
    if not value:
        return None

    placeholders = {
        "city",
        "state",
        "country",
        "city, st",
        "city, state",
    }
    if value.lower() in placeholders:
        return None
    return value


async def _extract_next_data(page: Page) -> dict:
    raw = await page.evaluate(
        """() => {
            const node = document.querySelector('script#__NEXT_DATA__');
            return node ? node.textContent : null;
        }"""
    )
    if not isinstance(raw, str) or not raw.strip():
        # Poshmark is often Vue-based and exposes bootstrap state here.
        state = await page.evaluate("""() => window.__INITIAL_STATE__ || null""")
        return state if isinstance(state, dict) else {}
    try:
        return json.loads(raw)
    except json.JSONDecodeError:
        return {}


async def _extract_structured_data(page: Page) -> dict:
    raw_blocks = await page.locator('script[type="application/ld+json"]').all_text_contents()
    product = {}
    breadcrumb = {}

    for raw in raw_blocks:
        raw = raw.strip()
        if not raw:
            continue
        try:
            payload = json.loads(raw)
        except json.JSONDecodeError:
            continue

        values = payload if isinstance(payload, list) else [payload]
        for value in values:
            if not isinstance(value, dict):
                continue
            item_type = value.get("@type")
            if item_type == "Product":
                product = value
            elif item_type == "BreadcrumbList":
                breadcrumb = value

    return {"product": product, "breadcrumb": breadcrumb}


