def use_project_interpreter() -> None:
    """Create project venv if needed, then run this script with that Python."""
    if not VENV_PYTHON.is_file():
        if not RUN_SCRIPT.is_file():
            raise RuntimeError(
                "The project virtual environment is missing and run.sh could not be found."
            )
        os.execv(str(RUN_SCRIPT), [str(RUN_SCRIPT)])

    try:
        running_prefix = Path(sys.prefix).resolve()
        project_prefix = VENV_DIR.resolve()
    except OSError:
        return

    if running_prefix != project_prefix:
        os.execv(
            str(VENV_PYTHON),
            [str(VENV_PYTHON), str(Path(__file__).resolve()), *sys.argv[1:]],
        )


def ensure_project_dependencies() -> None:
    """Install required runtime dependencies into the project venv if missing."""
    missing: list[str] = []
    required = {
        "crawlee": "crawlee[playwright]",
        "playwright": "playwright",
        "browserforge": "browserforge",
    }

    for module_name, package_name in required.items():
        if importlib.util.find_spec(module_name) is None:
            missing.append(package_name)

    if not missing:
        return

    print(f"Missing dependencies detected ({', '.join(missing)}). Installing into project venv...")

    try:
        subprocess.check_call([sys.executable, "-m", "pip", "install", "--upgrade", "pip"])
        subprocess.check_call([sys.executable, "-m", "pip", "install", *missing])

        if "playwright" in missing:
            subprocess.check_call([sys.executable, "-m", "playwright", "install", "chromium"])
    except subprocess.CalledProcessError as exc:
        raise RuntimeError(
            "Automatic dependency installation failed. "
            "Run ./poshmark/run.sh once, then rerun the scraper."
        ) from exc


if __name__ == "__main__":
    use_project_interpreter()
    ensure_project_dependencies()


