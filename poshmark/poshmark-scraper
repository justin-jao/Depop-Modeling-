async def _fetch_closet_location(page: Page, closet_href: Optional[str]) -> Optional[str]:
    if not isinstance(closet_href, str) or not closet_href.strip():
        return None

    closet_url = closet_href if closet_href.startswith("http") else f"https://poshmark.com{closet_href}"
    try:
        response = await page.request.get(closet_url)
    except Exception:
        return None

    if response.status != 200:
        return None

    body = await response.text()
    # Typical closet pages expose location as City, ST in visible text.
    match = re.search(r"\b([A-Z][a-zA-Z'\- ]+),\s*([A-Z]{2})\b", body)
    if not match:
        return None
    city = match.group(1).strip()
    state = match.group(2).strip()
    if city.lower() == "city" or state.upper() == "ST":
        return None
    return f"{city}, {state}"


def _extract_labeled_value(text: str, label: str) -> Optional[str]:
    pattern = rf"{label}\s*[:\-]?\s*([^\n\r]+)"
    match = re.search(pattern, text, flags=re.IGNORECASE)
    return match.group(1).strip() if match else None


def _extract_poshmark_seller_blob(state: dict, item_blob: dict) -> dict:
    candidates = []

    listing_details = state.get("$_listing_details") if isinstance(state.get("$_listing_details"), dict) else {}
    closet_state = state.get("$_closet") if isinstance(state.get("$_closet"), dict) else {}

    if isinstance(listing_details, dict):
        candidates.extend(
            [
                listing_details.get("listerData"),
                listing_details.get("listingDetails"),
                listing_details.get("seller"),
            ]
        )

    if isinstance(closet_state, dict):
        candidates.extend(
            [
                closet_state.get("closetUserInfo", {}).get("data") if isinstance(closet_state.get("closetUserInfo"), dict) else None,
                closet_state.get("user"),
                closet_state.get("seller"),
            ]
        )

    if isinstance(item_blob.get("seller"), dict):
        candidates.append(item_blob.get("seller"))
    if isinstance(item_blob.get("user"), dict):
        candidates.append(item_blob.get("user"))

    for candidate in candidates:
        if isinstance(candidate, dict) and candidate:
            return candidate

    return {}


def _extract_poshmark_items_sold(state: dict, item_blob: dict, body_text: str) -> Optional[int]:
    seller_blob = _extract_poshmark_seller_blob(state, item_blob)
    for key in (
        "items_sold",
        "itemsSold",
        "sold_count",
        "soldCount",
        "sales_count",
        "salesCount",
        "num_sales",
        "numSales",
        "sold_items",
        "soldItems",
        "total_sales",
        "totalSold",
    ):
        value = seller_blob.get(key)
        if value not in (None, "", [], {}):
            try:
                return int(value)
            except (TypeError, ValueError):
                text = str(value).strip()
                if text.isdigit():
                    return int(text)

    for key in ("items_sold", "itemsSold", "sold_count", "sales_count", "total_sales"):
        value = _find_first_value(state, (key,))
        if value not in (None, "", [], {}):
            try:
                return int(value)
            except (TypeError, ValueError):
                text = str(value).strip()
                if text.isdigit():
                    return int(text)

    if isinstance(body_text, str) and body_text:
        match = re.search(r"\b(\d+)\s+(?:items?\s+)?sold\b", body_text, flags=re.IGNORECASE)
        if match:
            return int(match.group(1))
        match = re.search(r"\bsold\s+(\d+)\b", body_text, flags=re.IGNORECASE)
        if match:
            return int(match.group(1))

    return None


def map_item(
    *,
    listing_url: str,
    query: str,
    next_data: dict,
    structured_data: dict,
    dom_hints: dict,
    closet_location: Optional[str],
) -> dict:
    listing_id = _extract_listing_id(listing_url)
    item_blob = _find_best_item_blob(next_data, listing_id)

    product = structured_data.get("product") if isinstance(structured_data.get("product"), dict) else {}
    breadcrumb = structured_data.get("breadcrumb") if isinstance(structured_data.get("breadcrumb"), dict) else {}

    body_text = dom_hints.get("bodyText") if isinstance(dom_hints.get("bodyText"), str) else ""
    details_text = dom_hints.get("detailsText") if isinstance(dom_hints.get("detailsText"), str) else ""
    internal_seller_id = _extract_internal_seller_id(next_data)
    seller_blob = _extract_poshmark_seller_blob(next_data, item_blob)

    listing_id = _first_non_empty(
        listing_id,
        item_blob.get("id") if isinstance(item_blob, dict) else None,
        _find_first_value(next_data, ("listing_id", "id")),
    )

    title = _first_non_empty(
        item_blob.get("title"),
        item_blob.get("name"),
        product.get("name"),
        dom_hints.get("ogTitle"),
    )

    desc = _first_non_empty(
        item_blob.get("description"),
        product.get("description"),
        dom_hints.get("ogDescription"),
    )

    raw_price = _first_non_empty(
        item_blob.get("price"),
        _find_first_value(next_data, ("price", "listing_price", "original_price")),
        product.get("offers"),
    )

    raw_currency = _first_non_empty(
        item_blob.get("currency"),
        item_blob.get("currency_code"),
        _find_first_value(next_data, ("currency", "currency_code", "price_currency")),
        (product.get("offers") or {}).get("priceCurrency") if isinstance(product.get("offers"), dict) else None,
    )

    if isinstance(raw_price, dict) and isinstance(product.get("offers"), dict):
        raw_price = _first_non_empty(raw_price, product.get("offers"))

    price, currency = _normalize_price(raw_price, raw_currency, body_text)

    brand = _first_non_empty(
        item_blob.get("brand"),
        item_blob.get("brand_name"),
        (item_blob.get("brand") or {}).get("name") if isinstance(item_blob.get("brand"), dict) else None,
        (product.get("brand") or {}).get("name") if isinstance(product.get("brand"), dict) else None,
        _extract_labeled_value(details_text, "Brand"),
    )

    size = _first_non_empty(
        item_blob.get("size"),
        item_blob.get("size_title"),
        _extract_labeled_value(details_text, "Size"),
    )

    condition = _first_non_empty(
        _normalize_item_condition(item_blob.get("condition")),
        _normalize_item_condition((product.get("offers") or {}).get("itemCondition") if isinstance(product.get("offers"), dict) else None),
        _extract_labeled_value(details_text, "Condition"),
    )

    image_url = _first_non_empty(
        item_blob.get("image_url"),
        item_blob.get("cover_shot") if isinstance(item_blob.get("cover_shot"), str) else None,
        (item_blob.get("cover_shot") or {}).get("url") if isinstance(item_blob.get("cover_shot"), dict) else None,
        (item_blob.get("pictures") or [{}])[0].get("url") if isinstance(item_blob.get("pictures"), list) and item_blob.get("pictures") else None,
        product.get("image") if isinstance(product.get("image"), str) else None,
        dom_hints.get("ogImage"),
    )

    created_at = _first_non_empty(
        _normalize_created_at(
            _first_non_empty(
                item_blob.get("created_at"),
                item_blob.get("createdAt"),
                item_blob.get("listed_at"),
                _find_first_value(next_data, ("created_at", "createdAt", "listed_at", "created_time")),
                dom_hints.get("datetimeText"),
            )
        ),
        _created_at_from_image_url(image_url),
        _relative_age_to_iso(dom_hints.get("timestampText")),
    )

    username = _first_non_empty(
        item_blob.get("username"),
        item_blob.get("seller_username"),
        (item_blob.get("seller") or {}).get("username") if isinstance(item_blob.get("seller"), dict) else None,
        seller_blob.get("username"),
        seller_blob.get("handle"),
        seller_blob.get("slug"),
        _find_first_value(next_data, ("username", "seller_username", "handle")),
    )

    closet_href = dom_hints.get("closetHref") if isinstance(dom_hints.get("closetHref"), str) else None
    if not username and closet_href:
        match = re.search(r"/closet/([^/?#]+)", closet_href)
        if match:
            username = match.group(1)

    if not username:
        match = re.search(r"@([A-Za-z0-9_-]+)", body_text)
        if match:
            username = match.group(1)

    seller_id = _first_non_empty(
        internal_seller_id,
        item_blob.get("creator_id"),
        item_blob.get("seller_id"),
        item_blob.get("user_id"),
        (item_blob.get("seller") or {}).get("id") if isinstance(item_blob.get("seller"), dict) else None,
        seller_blob.get("id"),
        seller_blob.get("user_id"),
        seller_blob.get("creator_id"),
        seller_blob.get("closet_id"),
        _find_first_value(next_data, ("creator_id", "seller_id", "user_id", "closet_id")),
        username,
    )

    breadcrumbs = []
    if isinstance(breadcrumb.get("itemListElement"), list):
        for entry in breadcrumb.get("itemListElement"):
            if not isinstance(entry, dict):
                continue
            item = entry.get("item")
            if isinstance(item, dict):
                name = item.get("name")
                if isinstance(name, str) and name.strip():
                    breadcrumbs.append(name.strip())

    dom_breadcrumbs = dom_hints.get("breadcrumbTitles") if isinstance(dom_hints.get("breadcrumbTitles"), list) else []
    category = _first_non_empty(
        product.get("category"),
        item_blob.get("category"),
        item_blob.get("category_name"),
        breadcrumbs[-1] if breadcrumbs else None,
        dom_breadcrumbs[-1] if dom_breadcrumbs else None,
        _extract_labeled_value(details_text, "Category"),
    )
    category = _lowest_category(category)

    location = _first_non_empty(
        _normalize_location(item_blob.get("location")),
        _normalize_location(_find_first_value(next_data, ("location", "city", "state", "ship_from"))),
        _normalize_location(_extract_labeled_value(details_text, "Location")),
        _normalize_location(_extract_labeled_value(body_text, "Ships from")),
        _normalize_location(closet_location),
    )

    return {
        "listing_id": str(listing_id) if listing_id is not None else None,
        "source": "poshmark",
        "source_url": listing_url,
        "title": title,
        "desc": desc,
        "price": price,
        "currency": currency,
        "brand": brand,
        "size": size,
        "condition": condition,
        "created_at": created_at,
        "seller_id": str(seller_id) if seller_id is not None else None,
        "username": username,
        "category": category,
        "location": location,
        "image_url": image_url,
        "scraped_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "search_query": query,
    }


def build_seller_record(*, next_data: dict, item_blob: dict, dom_hints: dict) -> dict:
    body_text = dom_hints.get("bodyText") if isinstance(dom_hints.get("bodyText"), str) else ""
    seller_blob = _extract_poshmark_seller_blob(next_data, item_blob)
    seller_id = _first_non_empty(
        seller_blob.get("id"),
        seller_blob.get("user_id"),
        seller_blob.get("creator_id"),
        seller_blob.get("closet_id"),
        _find_first_value(next_data, ("creator_id", "seller_id", "user_id", "closet_id")),
    )
    username = _first_non_empty(
        seller_blob.get("username"),
        seller_blob.get("handle"),
        seller_blob.get("slug"),
        _find_first_value(next_data, ("username", "seller_username", "handle")),
    )

    return {
        "source": "poshmark",
        "seller_id": str(seller_id) if seller_id is not None else None,
        "username": username,
        "rating": None,
        "items_sold": _extract_poshmark_items_sold(next_data, item_blob, body_text),
    }


async def _collect_listing_urls(page: Page, query: str, limit: int) -> list[str]:
    search_url = f"https://poshmark.com/search?query={quote_plus(query)}&type=listings&src=dir"
    await page.goto(search_url, wait_until="domcontentloaded", timeout=SEARCH_TIMEOUT_MS)
    try:
        await page.locator("a[href*='/listing/']").first.wait_for(timeout=8000)
    except Exception:
        pass

    links = await page.locator("a[href*='/listing/']").evaluate_all(
        """elements => elements.map((el) => el.href).filter(Boolean)"""
    )

    deduped: list[str] = []
    seen = set()
    for link in links:
        if not isinstance(link, str):
            continue
        if "/listing/" not in link:
            continue
        if link in seen:
            continue
        seen.add(link)
        deduped.append(link)
        if len(deduped) >= limit:
            break

    return deduped


async def run(query: str, limit: int = MAX_LISTINGS) -> list[dict]:
    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
    SELLER_OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
    STORAGE_DIR.mkdir(parents=True, exist_ok=True)

    run_id = str(uuid.uuid4())
    start_time = _utc_now_iso()

    print(f"Searching Poshmark for: {query}")
    results: list[dict] = []
    seen_sellers: set[str] = set()
    loading_zone_lock = asyncio.Lock()

    async def handle_search(context: PlaywrightCrawlingContext) -> None:
        urls = await _collect_listing_urls(context.page, query, limit)
        print(f"Found {len(urls)} listing URL(s), pulling detail pages...")

        closet_location_cache: dict[str, Optional[str]] = {}
        sem = asyncio.Semaphore(DETAIL_CONCURRENCY)

        async def process_listing(idx: int, url: str) -> Optional[dict]:
            async with sem:
                detail_page = await context.page.context.new_page()
                try:
                    await detail_page.goto(url, wait_until="domcontentloaded", timeout=DETAIL_TIMEOUT_MS)
                    try:
                        await detail_page.wait_for_load_state("networkidle", timeout=5000)
                    except Exception:
                        pass

                    next_data = await _extract_next_data(detail_page)
                    structured_data = await _extract_structured_data(detail_page)
                    dom_hints = await _extract_dom_hints(detail_page)

                    closet_href = dom_hints.get("closetHref")
                    closet_location = None
                    if isinstance(closet_href, str) and closet_href.strip():
                        cache_key = closet_href if closet_href.startswith("http") else f"https://poshmark.com{closet_href}"
                        if cache_key in closet_location_cache:
                            closet_location = closet_location_cache[cache_key]
                        else:
                            closet_location = await _fetch_closet_location(detail_page, closet_href)
                            closet_location_cache[cache_key] = closet_location

                    record = map_item(
                        listing_url=url,
                        query=query,
                        next_data=next_data,
                        structured_data=structured_data,
                        dom_hints=dom_hints,
                        closet_location=closet_location,
                    )
                    record = _replace_nulls(record)

                    listing_id = record.get("listing_id") or f"idx_{idx + 1}"
                    out_file = OUTPUT_DIR / f"{listing_id}.json"
                    out_file.write_text(
                        json.dumps(record, indent=2, ensure_ascii=False),
                        encoding="utf-8",
                    )

                    seller_record = build_seller_record(
                        next_data=next_data,
                        item_blob=_find_best_item_blob(next_data, record.get("listing_id")),
                        dom_hints=dom_hints,
                    )
                    seller_record = _replace_nulls(seller_record)
                    seller_key = seller_record.get("seller_id") or seller_record.get("username")
                    if seller_key and seller_key not in seen_sellers:
                        seen_sellers.add(seller_key)
                        seller_file = SELLER_OUTPUT_DIR / f"{seller_key}.json"
                        seller_file.write_text(
                            json.dumps(seller_record, indent=2, ensure_ascii=False),
                            encoding="utf-8",
                        )

                    raw_listing_row = {
                        "id": str(uuid.uuid4()),
                        "run_id": run_id,
                        "source_url": url,
                        "api_payload": {
                            "next_data": next_data,
                            "structured_data": structured_data,
                            "dom_hints": dom_hints,
                        },
                        "loaded_at": _utc_now_iso(),
                        "processed": False,
                    }
                    raw_listing_row = _replace_nulls(raw_listing_row)
                    async with loading_zone_lock:
                        _append_jsonl(RAW_LISTINGS_PATH, raw_listing_row)

                    print(f"  [{idx + 1}/{len(urls)}] wrote {out_file}")
                    return record
                except Exception as exc:
                    print(f"  [{idx + 1}/{len(urls)}] FAILED {url}: {exc}")
                    return None
                finally:
                    await detail_page.close()

        processed = await asyncio.gather(*(process_listing(i, url) for i, url in enumerate(urls)))
        results.extend([item for item in processed if item is not None])

    start_url = f"https://poshmark.com/search?query={quote_plus(query)}&type=listings&src=dir"
    crawler = PlaywrightCrawler(
        request_handler=handle_search,
        headless=True,
        max_requests_per_crawl=1,
    )

    await crawler.run([Request.from_url(start_url, user_data={"query": query})])

    print(f"\nWrote {len(results)} listing files to {OUTPUT_DIR}/")
    print(f"Wrote {len(seen_sellers)} seller files to {SELLER_OUTPUT_DIR}/")

    scrape_run_row = {
        "run_id": run_id,
        "search_query": query,
        "start_time": start_time,
        "finish_time": _utc_now_iso(),
        "Listing_count": len(results),
    }
    scrape_run_row = _replace_nulls(scrape_run_row)
    _append_jsonl(SCRAPE_RUNS_PATH, scrape_run_row)

    print(f"Updated loading-zone tables at {SCRAPE_RUNS_PATH} and {RAW_LISTINGS_PATH}")
    return results


if __name__ == "__main__":
    user_query = input("Enter your Poshmark search query: ").strip()
    asyncio.run(run(user_query))